NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ---- Smart Contracts (Arbitrum Sepolia) ----
# Deployed on 2026-02-06
NEXT_PUBLIC_ARCANA_TOKEN_ADDRESS=0x97158e24465C30D09557e1853460c74D3ee00F5E
NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=0xaDD672721dff93448A5701F0a55EcDb7cA512d1A
NEXT_PUBLIC_DIVIDEND_POOL_ADDRESS=0x51FEb9273B01d96C3cff5Ded91521248AaAc587B
NEXT_PUBLIC_PAYMASTER_ADDRESS=0xa3A7C33C21c6B347B220B174928609A7Ae74BD10

# ---- iExec Configuration ----
# iApp deployed on 2026-02-06
NEXT_PUBLIC_IAPP_ADDRESS=0x4dF342F232BD89705090c00081924555E849FDb5

# ---- Network Configuration ----
# Arbitrum Sepolia Testnet RPC (public endpoint)
NEXT_PUBLIC_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

