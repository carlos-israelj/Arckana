# Admin wallet private key (for signing transactions)
# This wallet should:
# - Own the DividendPool contract (be the admin)
# - Have sufficient PaymentToken balance for distribution
# - Have ETH for gas fees
ADMIN_PRIVATE_KEY=0x1234567890abcdef...

# Optional: Custom RPC endpoint
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

